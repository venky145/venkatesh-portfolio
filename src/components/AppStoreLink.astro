---
interface Props {
  href: string;
  name: string;
  compact?: boolean;
}

const { href, name, compact = false } = Astro.props;
---

<a
  class:list={["appstore-link", { compact }]}
  href={href}
  rel="noreferrer"
  aria-label={`${name} on the App Store`}
>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path
      fill="currentColor"
      d="M16.37 1.43c0 1.14-.5 2.27-1.18 3.08-.74.9-1.99 1.57-2.99 1.57-.12 0-.23-.02-.3-.03-.01-.06-.04-.22-.04-.39 0-1.15.57-2.27 1.2-2.98.81-.94 2.15-1.64 3.25-1.68.03.13.06.28.06.43zm4.56 15.71c-.03.07-.46 1.58-1.52 3.12-.94 1.37-1.94 2.73-3.48 2.76-1.52.03-2.01-.91-3.74-.91-1.74 0-2.28.88-3.71.94-1.5.06-2.64-1.48-3.59-2.84-1.95-2.8-3.45-7.91-1.44-11.36 1-1.72 2.78-2.81 4.71-2.84 1.47-.03 2.86.99 3.74.99.88 0 2.52-1.22 4.25-1.04.72.03 2.75.29 4.05 2.19-.1.07-2.42 1.41-2.4 4.21.03 3.35 2.94 4.46 2.97 4.48z"
    />
  </svg>
  {!compact && <span>App Store</span>}
</a>
