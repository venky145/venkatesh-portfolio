---
import SocialIcon from "./SocialIcon.astro";
import { contactLinks, type ContactLink } from "../data/site";

const links = contactLinks();
const textLinks = links.filter((link) => !link.icon);
const socialLinks = links.filter(
  (link): link is ContactLink & { icon: "linkedin" | "github" | "medium" } =>
    link.icon !== undefined,
);
const show = links.length > 0 || import.meta.env.DEV;
---

{
  show && (
    <section id="contact" aria-labelledby="contact-title">
      <div class="wrap">
        <h2 id="contact-title">Contact</h2>
        {links.length > 0 ? (
          <p class="contact-links">
            {textLinks.map((link) => (
              <a href={link.href} rel="me noreferrer">
                {link.label}
              </a>
            ))}
            <span class="icon-links">
              {socialLinks.map((link) => (
                <a href={link.href} class="icon-link" aria-label={link.label} rel="me noreferrer">
                  <SocialIcon name={link.icon} />
                </a>
              ))}
            </span>
          </p>
        ) : (
          <p class="dev-note">
            Add LinkedIn, GitHub, and email in src/data/site.ts. This section stays off the
            production site until a link exists.
          </p>
        )}
      </div>
    </section>
  )
}
