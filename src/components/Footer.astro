---
import { contactLinks, site } from "../data/site";

const links = contactLinks();
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <p class="footer-name">{site.name}</p>
    <p>Senior Mobile Engineer — iOS & React Native</p>
    {
      links.length > 0 && (
        <ul class="footer-links">
          {links.map((link) => (
            <li>
              <a href={link.href} rel="me noreferrer">{link.label}</a>
            </li>
          ))}
        </ul>
      )
    }
    <p class="copyright">© {year} {site.name}</p>
  </div>
</footer>
