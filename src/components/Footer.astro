---
import SocialIcon from "./SocialIcon.astro";
import { contactLinks, site, type ContactLink } from "../data/site";

const links = contactLinks();
const textLinks = links.filter((link) => !link.icon);
const socialLinks = links.filter(
  (link): link is ContactLink & { icon: "linkedin" | "github" | "medium" } =>
    link.icon !== undefined,
);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <p class="footer-name">{site.name}</p>
    <p>Senior Mobile Engineer — iOS & React Native</p>
    {
      textLinks.length > 0 && (
        <ul class="footer-links">
          {textLinks.map((link) => (
            <li>
              <a href={link.href} rel="me noreferrer">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
    {
      socialLinks.length > 0 && (
        <ul class="footer-social">
          {socialLinks.map((link) => (
            <li>
              <a href={link.href} aria-label={link.label} rel="me noreferrer">
                <SocialIcon name={link.icon} />
              </a>
            </li>
          ))}
        </ul>
      )
    }
    <p class="copyright">© {year} {site.name}</p>
  </div>
</footer>
