---
import { getCollection } from "astro:content";
import ProjectRow from "./ProjectRow.astro";

const projects = (await getCollection("projects", ({ data }) => data.featured)).sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0),
);

const professional = projects.filter((project) => project.data.kind === "professional");
const personal = projects.filter((project) => project.data.kind === "personal");
---

<section id="work" aria-labelledby="work-title">
  <div class="wrap">
    <h2 id="work-title">Selected Work</h2>

    {
      professional.length > 0 ? (
        <div class="work-group">
          <p class="group-label" id="professional-label">
            Professional Work
          </p>
          <ul class="project-list" aria-labelledby="professional-label">
            {professional.map((project) => (
              <li>
                <ProjectRow project={project} />
              </li>
            ))}
          </ul>
        </div>
      ) : (
        import.meta.env.DEV && (
          <div class="work-group">
            <p class="group-label">Professional Work</p>
            <p class="dev-note">
              Add one Markdown file per engagement in src/content/projects. Include only
              details you are willing to publish. This group stays off the production site
              until a file exists.
            </p>
          </div>
        )
      )
    }

    {
      personal.length > 0 && (
        <div class="work-group">
          <p class="group-label" id="personal-label">
            Personal Products
          </p>
          <ul class="project-list" aria-labelledby="personal-label">
            {personal.map((project) => (
              <li>
                <ProjectRow project={project} />
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>
