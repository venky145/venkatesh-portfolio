---
import { getCollection } from "astro:content";
import AppCarousel from "../components/AppCarousel.astro";
import AppFeature from "../components/AppFeature.astro";
import TabbedFeature from "../components/TabbedFeature.astro";
import AppStoreLink from "../components/AppStoreLink.astro";
import { fintechTabs, livesmartTabs, ottTabs, tokenTabs } from "../data/app-tabs";
import { clients } from "../data/clients";
import { companies } from "../data/companies";
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = (await getCollection("projects", ({ data }) => data.featured)).sort((a, b) => {
  if (a.data.kind !== b.data.kind) {
    return a.data.kind === "professional" ? -1 : 1;
  }
  return (a.data.order ?? 0) - (b.data.order ?? 0);
});

const skipped = new Set(["nagra-streaming", "fintech"]);
const placedLater = new Set(["senior-life", "wearables"]);
const featureProjects = projects.filter(
  (project) => !skipped.has(project.id) && !placedLater.has(project.id),
);
const laterProjects = projects.filter((project) => placedLater.has(project.id));
const professionalFeatures = featureProjects.filter((project) => project.data.kind === "professional");
const personalFeatures = featureProjects.filter((project) => project.data.kind === "personal");
---

<BaseLayout>
  <section id="apps" aria-labelledby="apps-title">
    <div class="wrap">
      <div class="home-intro">
        <p>
          12+ years building iOS, tvOS and React Native apps:<br />
          streaming for millions, regulated banking, crypto wallets and IoT.
        </p>
      </div>
      <div class="company-strip">
        <p class="kind-label">Companies I've worked for</p>
        <ul class="company-row">
          {
            companies.map((company) => (
              <li>
                <img src={company.src} alt={company.name} />
                {company.app && <AppStoreLink href={company.app} name={company.name} compact />}
                {company.apps && (
                  <span class="store-marks">
                    {company.apps.map((app) => (
                      <AppStoreLink href={app.href} name={app.name} compact />
                    ))}
                  </span>
                )}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="company-strip client-strip">
        <p class="kind-label">Clients I've worked with</p>
        <ul class="company-row">
          {
            clients.map((client) => (
              <li>
                <img src={client.src} alt={client.name} />
                {client.app && <AppStoreLink href={client.app} name={client.name} compact />}
              </li>
            ))
          }
        </ul>
      </div>
      <AppCarousel projects={projects} />
      <div class="feature-pager">
        <div class="feature-pager-bar">
          <p class="feature-pager-count" data-pager-count aria-live="polite"></p>
          <div class="carousel-controls">
            <button type="button" data-page="prev" aria-label="Previous app">
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M12.5 4.5 7 10l5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </button>
            <button type="button" data-page="next" aria-label="Next app">
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M7.5 4.5 13 10l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </button>
          </div>
        </div>
      <div class="features">
        <TabbedFeature group={ottTabs} tone={1} />
        {
          professionalFeatures.map((project) => (
            <AppFeature project={project} flip tone={2} />
          ))
        }
        <TabbedFeature group={fintechTabs} flip tone={3} />
      <TabbedFeature group={tokenTabs} tone={4} />
      <TabbedFeature group={livesmartTabs} flip tone={5} />
        {
          laterProjects.map((project, index) => (
            <AppFeature project={project} flip={index % 2 === 1} tone={index + 6} />
          ))
        }
        {
          personalFeatures.map((project, index) => (
            <AppFeature project={project} flip={index % 2 === 0} tone={(index % 7) + 4} />
          ))
        }
      </div>
        <div class="page-control" data-pager-dots role="group" aria-label="Choose an app"></div>
      </div>
    </div>
  </section>

  <section class="home-close" aria-labelledby="more-title">
    <div class="wrap">
      <h2 id="more-title">Learn more about my experience</h2>
      <p class="apps-lead">Roles, engineering, and how to reach me.</p>
      <p class="actions">
        <a href="/about">About me</a>
        <a href="/about#contact">Contact me</a>
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  const track = document.querySelector<HTMLElement>(".carousel-track");
  const filters = document.querySelectorAll<HTMLButtonElement>(".filters [data-filter]");
  const pager = document.querySelector<HTMLElement>(".feature-pager");
  const pagerCount = pager?.querySelector<HTMLElement>("[data-pager-count]");
  const pagerDots = pager?.querySelector<HTMLElement>("[data-pager-dots]");
  const pageButtons = pager?.querySelectorAll<HTMLButtonElement>("[data-page]");
  let page = 0;
  let introduced = false;

  function visibleFeatures() {
    return [...document.querySelectorAll<HTMLElement>(".feature")].filter((element) => !element.hidden);
  }

  function featureTitle(feature: HTMLElement) {
    const heading =
      feature.querySelector<HTMLElement>('[role="tabpanel"]:not([hidden]) h2') ??
      feature.querySelector("h2");
    return heading?.textContent?.trim() || "App";
  }

  function showPage(next: number, options?: { scroll?: boolean }) {
    const features = visibleFeatures();
    document.querySelectorAll<HTMLElement>(".feature.is-current").forEach((element) => {
      if (element.hidden) element.classList.remove("is-current");
    });

    if (!features.length) {
      pager?.classList.add("is-ready");
      if (pagerCount) pagerCount.textContent = "";
      pagerDots?.replaceChildren();
      pageButtons?.forEach((button) => {
        button.disabled = true;
      });
      return;
    }

    const target = Math.min(Math.max(next, 0), features.length - 1);
    const same = target === page && features[target]?.classList.contains("is-current");
    const backward = target < page;
    page = target;
    features.forEach((feature, index) => {
      const current = index === page;
      feature.classList.toggle("is-current", current);
      if (current) {
        feature.classList.add("is-in");
        feature.classList.remove("reveal");
      }
    });
    pager?.classList.add("is-ready");

    const current = features[page];
    if (introduced && !same && current) {
      current.classList.remove("is-appearing");
      current.classList.toggle("is-back", backward);
      void current.offsetWidth;
      current.classList.add("is-appearing");
      if (pagerCount) {
        pagerCount.classList.remove("is-appearing");
        void pagerCount.offsetWidth;
        pagerCount.classList.add("is-appearing");
      }
    }
    introduced = true;

    if (pagerCount) {
      pagerCount.textContent = `${page + 1} of ${features.length} · ${featureTitle(features[page])}`;
    }

    if (pagerDots) {
      pagerDots.replaceChildren();
      features.forEach((feature, index) => {
        const dot = document.createElement("button");
        dot.type = "button";
        dot.setAttribute("aria-label", featureTitle(feature));
        if (index === page) dot.setAttribute("aria-current", "true");
        dot.addEventListener("click", () => showPage(index, { scroll: true }));
        pagerDots.append(dot);
      });
    }

    pageButtons?.forEach((button) => {
      const direction = button.dataset.page;
      button.disabled =
        features.length < 2 || (direction === "prev" && page === 0) || (direction === "next" && page === features.length - 1);
    });

    if (options?.scroll && pager) {
      const top = pager.getBoundingClientRect().top;
      if (top < 64 || top > window.innerHeight * 0.4) {
        pager.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    }
  }

  function showFeature(feature: HTMLElement, options?: { scroll?: boolean }) {
    if (feature.hidden) {
      const kind = feature.dataset.kind;
      if (kind) setFilter(kind);
    }
    const index = visibleFeatures().indexOf(feature);
    if (index >= 0) showPage(index, options);
  }

  function setFilter(kind: string) {
    document.querySelectorAll<HTMLElement>("[data-kind]").forEach((element) => {
      const match = kind === "all" || element.dataset.kind === kind;
      element.hidden = !match;
    });

    filters.forEach((button) => {
      button.setAttribute("aria-pressed", button.dataset.filter === kind ? "true" : "false");
    });

    track?.scrollTo({ left: 0 });
  }

  function applyFilter(kind: string) {
    setFilter(kind);
    showPage(0);
  }

  filters.forEach((button) => {
    button.addEventListener("click", () => {
      const kind = button.dataset.filter;
      if (kind) applyFilter(kind);
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-carousel]").forEach((button) => {
    button.addEventListener("click", () => {
      if (!track) return;
      const card = track.querySelector<HTMLElement>("li:not([hidden]) .app-card");
      const distance = card ? card.getBoundingClientRect().width + 14 : 280;
      const direction = button.dataset.carousel === "next" ? 1 : -1;
      track.scrollBy({ left: direction * distance, behavior: "smooth" });
    });
  });

  type Shot = { src: string; alt?: string; frame?: string };

  function readShots(raw: string | undefined): Shot[] {
    if (!raw) return [];
    try {
      const parsed = JSON.parse(raw) as Shot[];
      return Array.isArray(parsed) ? parsed.filter((shot) => shot?.src) : [];
    } catch {
      return [];
    }
  }

  function attachStage(stage: HTMLElement) {
    const photo = stage.querySelector<HTMLImageElement>(":scope > .feature-photo");
    const scroller = stage.querySelector<HTMLElement>(".phone-scroll");
    const prev = stage.querySelector<HTMLButtonElement>(".stage-prev");
    const next = stage.querySelector<HTMLButtonElement>(".stage-next");
    const dots = stage.querySelector<HTMLElement>(".stage-dots");
    let shots: Shot[] = [];
    let index = 0;

    function renderPhoneScroll() {
      if (!scroller) return;
      scroller.replaceChildren();
      shots.forEach((shot) => {
        const item = document.createElement("li");
        const image = document.createElement("img");
        image.src = shot.src;
        image.alt = shot.alt ?? "";
        item.append(image);
        scroller.append(item);
      });
      scroller.scrollLeft = 0;
    }

    function render() {
      const phoneScroll = shots.length > 1 && shots.every((shot) => shot.frame === "phone");
      stage.classList.toggle("is-phone-scroll", phoneScroll);
      if (scroller) scroller.hidden = !phoneScroll;
      if (photo) photo.hidden = phoneScroll;
      if (phoneScroll) {
        if (prev) prev.hidden = true;
        if (next) next.hidden = true;
        if (dots) dots.hidden = true;
        stage.classList.remove("has-nav");
        renderPhoneScroll();
        return;
      }

      const shot = shots[index];
      if (!photo || !shot) return;
      photo.src = shot.src;
      photo.alt = shot.alt ?? "";
      const multiple = shots.length > 1;
      stage.classList.toggle("has-nav", multiple);
      if (prev) prev.hidden = !multiple;
      if (next) next.hidden = !multiple;
      if (!dots) return;
      dots.hidden = !multiple;
      dots.replaceChildren();
      if (!multiple) return;
      shots.forEach((item, itemIndex) => {
        const dot = document.createElement("button");
        dot.type = "button";
        dot.setAttribute("aria-label", `Image ${itemIndex + 1} of ${shots.length}`);
        if (itemIndex === index) dot.setAttribute("aria-current", "true");
        dot.addEventListener("click", () => {
          index = itemIndex;
          render();
        });
        dots.append(dot);
      });
    }

    prev?.addEventListener("click", () => {
      if (shots.length < 2) return;
      index = (index - 1 + shots.length) % shots.length;
      render();
    });
    next?.addEventListener("click", () => {
      if (shots.length < 2) return;
      index = (index + 1) % shots.length;
      render();
    });

    return {
      setShots(nextShots: Shot[]) {
        shots = nextShots;
        index = 0;
        render();
      },
    };
  }

  document.querySelectorAll<HTMLElement>("[data-tabs]").forEach((root) => {
    const tabButtons = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const stage = root.querySelector<HTMLElement>("[data-stage]");
    const viewer = stage ? attachStage(stage) : null;

    tabButtons.forEach((tab) => {
      tab.addEventListener("click", () => {
        tabButtons.forEach((button, buttonIndex) => {
          const selected = button === tab;
          button.setAttribute("aria-selected", selected ? "true" : "false");
          panels[buttonIndex].hidden = !selected;
        });
        viewer?.setShots(readShots(tab.dataset.shots));
      });
    });

    const selected = tabButtons.find((tab) => tab.getAttribute("aria-selected") === "true");
    if (selected) viewer?.setShots(readShots(selected.dataset.shots));
  });

  document.querySelectorAll<HTMLElement>("[data-stage][data-shots]").forEach((stage) => {
    if (stage.closest("[data-tabs]")) return;
    attachStage(stage).setShots(readShots(stage.dataset.shots));
  });

  function openFromHash(scroll: boolean) {
    const id = location.hash.replace("#", "");
    if (!id) return;
    const target = document.getElementById(id);
    if (!target) return;

    if (target.getAttribute("role") === "tab") {
      const feature = target.closest<HTMLElement>(".feature");
      if (feature) showFeature(feature, { scroll });
      target.click();
      showPage(page);
      return;
    }

    if (target.classList.contains("feature")) showFeature(target, { scroll });
  }

  pageButtons?.forEach((button) => {
    button.addEventListener("click", () => {
      const direction = button.dataset.page === "next" ? 1 : -1;
      showPage(page + direction, { scroll: true });
    });
  });

  document.querySelectorAll<HTMLAnchorElement>(".app-card").forEach((card) => {
    card.addEventListener("click", (event) => {
      const href = card.getAttribute("href") ?? "";
      if (!href.startsWith("#")) return;
      const feature = document.getElementById(href.slice(1));
      if (!feature?.classList.contains("feature")) return;
      event.preventDefault();
      history.pushState(null, "", href);
      showFeature(feature, { scroll: true });
    });
  });

  pager?.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement) || !target.closest('[role="tab"]')) return;
    queueMicrotask(() => showPage(page));
  });

  showPage(0);
  openFromHash(true);
  window.addEventListener("hashchange", () => openFromHash(true));
</script>
